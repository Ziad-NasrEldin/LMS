{
  "inputs": [
    {
      "type": "promptString",
      "id": "stitch-api-key",
      "description": "Stitch API key",
      "password": true
    }
  ],
  "servers": {
    "stitch": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@_davideast/stitch-mcp", "proxy"],
      "env": {
        "STITCH_API_KEY": "${input:stitch-api-key}"
      }
    }
  }
}
